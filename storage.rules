rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 允許公開讀取 service-fields 文件夾中的圖片
    match /service-fields/{image} {
      allow read: if true;  // 公開讀取
      allow write: if request.auth != null;  // 需要登入才能寫入
    }
    
    // 其他文件需要認證
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
