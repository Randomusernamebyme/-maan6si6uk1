rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: 檢查用戶是否為管理員
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function: 檢查用戶是否為已審核的義工
    function isApprovedVolunteer() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'volunteer' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // 用戶集合
    match /users/{userId} {
      // 用戶只能讀取和更新自己的資料
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // 管理員可以讀取所有用戶資料
      allow read: if isAdmin();
      // 管理員可以更新和刪除所有用戶資料
      allow write: if isAdmin();
    }
    
    // 委托集合
    match /requests/{requestId} {
      // 任何人都可以創建委托（status 必須是 'pending'）
      allow create: if request.resource.data.status == 'pending';
      
      // 已登入用戶可以讀取公開的委托（status='published' 或 'open'）
      // 已登入用戶也可以讀取進行中的委托（status='matched', 'in-progress', 'completed'）
      // 管理員可以讀取所有委托
      allow read: if request.auth != null && 
        (resource.data.status == 'published' || 
         resource.data.status == 'open' || 
         resource.data.status == 'matched' ||
         resource.data.status == 'in-progress' ||
         resource.data.status == 'completed' ||
         isAdmin());
      
      // 只有管理員可以更新和刪除委托
      allow update, delete: if isAdmin();
    }
    
    // 報名記錄集合
    match /applications/{applicationId} {
      // 已審核的義工可以創建報名記錄
      allow create: if isApprovedVolunteer() && 
        request.resource.data.volunteerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // 義工可以讀取自己的報名記錄
      // 管理員可以讀取所有報名記錄
      allow read: if request.auth != null && 
        (resource.data.volunteerId == request.auth.uid || isAdmin());
      
      // 只有管理員可以更新和刪除報名記錄
      allow update, delete: if isAdmin();
    }
    
    // 通知集合
    match /notifications/{notificationId} {
      // 用戶只能讀取自己的通知
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // 用戶可以更新自己的通知（標記為已讀）
      // 只允許更新 read, readAt, updatedAt 字段
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
      
      // 只有管理員可以創建和刪除通知
      allow create, delete: if isAdmin();
    }
    
    // 操作日誌集合
    match /activity_logs/{logId} {
      // 只有管理員可以讀寫操作日誌
      allow read, write: if isAdmin();
    }
    
    // 系統設定集合
    match /settings/{settingId} {
      // 只有管理員可以讀寫設定
      allow read, write: if isAdmin();
    }
  }
}
